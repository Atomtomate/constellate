{
  "name": "constellate-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "generate:api-types": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts",
    "check:api-types": "npm run generate:api-types && git diff --exit-code src/api/schema.d.ts",
    "test": "vitest run",
    "postbuild": "node -e \"require('fs').writeFileSync('dist/.built','')\""
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3"
  },
  "engines": {
    "node": "^22.18.0 || >=24.2.0"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
